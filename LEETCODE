class Solution(object):
    def findDisappearedNumbers(self, nums):
        for num in nums:
            index = abs(num) - 1
            if nums[index] > 0:
              nums[index] = -nums[index]

        result = [i + 1 for i in range(len(nums)) if nums[i] > 0]
        return result
