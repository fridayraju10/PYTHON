class Solution(object):
    def countAndSay(self, n):
        result = "1"
        for _ in range(1, n):
            current = result
            result = ""
            i = 0
            while i < len(current):
                count = 1
                while i + 1 < len(current) and current[i] == current[i + 1]:
                    i += 1
                    count += 1
                result += str(count) + current[i]
                i += 1

        return result

