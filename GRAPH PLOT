import matplotlib.pyplot as plt
import numpy as np
overs = np.arange(1, 11)
score = [1, 6, 20, 3, 5, 6, 13, 5, 7, 21]
plt.plot(overs, score, marker='o', linestyle='-', color='blue', label="India Score")
plt.title("India Score Over 10 Overs")
plt.xlabel("Over Number")
plt.ylabel("Runs Scored")
plt.xticks(overs)
plt.grid(True)
plt.legend()
plt.show()
