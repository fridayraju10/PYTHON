    x.insert(5)

    print("The Inorder is...")
    x.in_order(x.root)
    print("\nThe Preorder is...")
    x.pre_order(x.root)
    print("\nThe Postorder is...")
    x.post_order(x.root)
    
    # Search test
    x.search(10)
