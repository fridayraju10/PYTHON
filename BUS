from datetime import datetime

class Bus:
    def __init__(self, bus_no, ac, capacity):
        self.bus_no = bus_no
        self.ac = ac
        self.capacity = capacity

    def get_bus_no(self):
        return self.bus_no

    def is_ac(self):
        return self.ac

    def get_capacity(self):
        return self.capacity

    def set_ac(self, val):
        self.ac = val

    def set_capacity(self, cap):
        self.capacity = cap

    def display_bus_info(self):
        print(f"Bus No: {self.bus_no} AC: {self.ac} Total Capacity: {self.capacity}")


