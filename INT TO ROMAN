def find(num):
    roman_map = {
        10: 'X',
        9: 'IX',
        5: 'V',
        4: 'IV',
        1: 'I'
    }
    values = [10, 9, 5, 4, 1]
    roman = ''
    for value in values:
        while num >= value:
            roman += roman_map[value]
            num -= value
    
    return roman
number = 19
print(find(number))
