def lengthOfLIS(nums):
    if not nums:
        return 0
    
    dp = [1] * len(nums)
    maxLIS = 1

    for i in range(1, len(nums)):
        for j in range(i):
            if nums[i] > nums[j]:
                dp[i] = max(dp[i], dp[j] + 1)
        maxLIS = max(maxLIS, dp[i])
    
    return maxLIS


nums = [10, 9, 2, 5, 3, 7, 101, 18]
result = lengthOfLIS(nums)
print("Output:", result)
