def csk(cost):
    a = cost[0]
    b = cost[1]

    for i in range(2, len(cost)):
        ans = min(a, b) + cost[i]
        a = b
        b = ans

    return min(a, b)


cost = [1,100,1,1,1,100,1,1,100,1]
print("cost:", csk(cost))
